<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FluentControl" Manufacturer="FluentControl" Version="$(var.ProductVersion)"
           UpgradeCode="2A0EC0F8-C99E-4B42-A42D-CB4BEE512F79" Scope="perUser"
           Language="2052" Codepage="936" InstallerVersion="500" Compressed="yes">
    <!-- Register the new clients of stable components before removing the old
         product. Its cached MSI must not delete/reinstall unchanged runtimes or
         hand those files to its older Restart Manager policy. Both operations
         stay inside the rollback transaction. Keep component GUIDs/keypaths. -->
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 FluentControl。" Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" MaximumUncompressedMediaSize="1024" />
    <!-- Windows Installer's legacy WindowsBuild/VersionNT values can be shimmed
         to Windows 8.1. Read the actual build before checking the app minimum. -->
    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="ActualWindowsBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 19041)"
            Message="FluentControl 需要 Windows 10 2004 或更高版本的 64 位系统。" />
    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Assets\FluentControl.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://fctrl.app" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- All runtime files are private to INSTALLFOLDER. Do not let Restart
         Manager close/restart other desktop applications. Keep the standard
         FilesInUse dialog and Windows Installer's real file-lock handling. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="原有配置会自动保留。若安装要求重启，请重启 Windows 后再打开应用。" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即启动 FluentControl" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- UI-only: a quiet install, repair, uninstall or canceled wizard must
         never start the app. FileRef resolves the selected installation path. -->
    <CustomAction Id="LaunchFluentControl" FileRef="ApplicationExe" ExeCommand="" Return="asyncNoWait" />

    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallDirectory" Root="HKCU" Key="Software\FluentControl\Installer"
                      Name="InstallDirectory" Type="raw" Bitness="always64" />
    </Property>
    <!-- Stable components cannot move between directories during a major
         upgrade. Restore this in both sequences, including silent installs. -->
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both"
                 Condition="PREVIOUSINSTALLFOLDER" />
    <Property Id="START_WITH_WINDOWS" Secure="yes" />
    <Property Id="EXISTINGSTARTUPLINK" Secure="yes">
      <DirectorySearch Id="FindStartupFolder" Path="[StartupFolder]" Depth="0">
        <FileSearch Id="FindStartupLink" Name="FluentControl.lnk" />
      </DirectorySearch>
    </Property>
    <Property Id="LEGACYSTARTUPCOMMAND" Secure="yes">
      <RegistrySearch Id="FindLegacyStartup" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="FluentControl" Type="raw" Bitness="always64" />
    </Property>
    <!-- Initialize only once: unchecking in the UI must not be undone by
         execute-sequence AppSearch. A command-line 0 explicitly opts out. -->
    <SetProperty Id="START_WITH_WINDOWS" Action="InitializeStartupChoice" Value="1" After="AppSearch" Sequence="first"
                 Condition="NOT START_WITH_WINDOWS AND (EXISTINGSTARTUPLINK OR LEGACYSTARTUPCOMMAND &gt;&gt; &quot; --background&quot;)" />
    <!-- MSI checkboxes use an empty property for their unchecked state. -->
    <SetProperty Id="START_WITH_WINDOWS" Action="ClearDisabledStartupChoice" Value="[FluentControlEmpty]"
                 After="InitializeStartupChoice" Sequence="first" Condition="START_WITH_WINDOWS = &quot;0&quot;" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FluentControl" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuEntry" Name="FluentControl" Target="[INSTALLFOLDER]FluentControl.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Description="聚合控制" />
        <RegistryValue Root="HKCU" Key="Software\FluentControl\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="StartupFolder">
      <!-- The app reads/writes this same non-advertised link. Re-evaluate its
           actual presence on repair/upgrade instead of reviving a stale flag. -->
      <Component Id="StartupShortcut" Guid="*" Transitive="yes" Condition="START_WITH_WINDOWS = &quot;1&quot;">
        <Shortcut Id="StartupEntry" Name="FluentControl" Target="[INSTALLFOLDER]FluentControl.exe"
                  Arguments="--background" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon"
                  Description="FluentControl" Show="minimized" />
        <RegistryValue Root="HKCU" Key="Software\FluentControl\Installer" Name="StartupShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryValue Id="MigrateLegacyStartup" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="FluentControl" />
      </Component>
      <Component Id="DisabledStartup" Guid="*" Transitive="yes" Condition="START_WITH_WINDOWS &lt;&gt; &quot;1&quot;">
        <RegistryValue Root="HKCU" Key="Software\FluentControl\Installer" Name="DisabledStartup" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFile Id="DisableStartupLink" Name="FluentControl.lnk" On="install" />
        <RemoveRegistryValue Id="DisableLegacyStartup" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="FluentControl" />
      </Component>
    </StandardDirectory>
    <!-- Also remove app-created links on a real uninstall, but never from the
         legacy package's removal during an upgrade. All file changes roll back. -->
    <SetProperty Id="STARTUPCLEANUPDIR" Value="[StartupFolder]" Before="RemoveFiles" Sequence="execute"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="InstallationRegistration" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\FluentControl\Installer" Name="InstallDirectory" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFile Id="RemoveStartupShortcut" Name="FluentControl.lnk" Property="STARTUPCLEANUPDIR" On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
    <Feature Id="Application" Title="FluentControl" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="InstallationRegistration" />
      <ComponentRef Id="StartupShortcut" />
      <ComponentRef Id="DisabledStartup" />
    </Feature>
    <UIRef Id="FluentControlUI" />
    <UIRef Id="WixUI_ErrorProgressText" />
  </Package>
</Wix>
