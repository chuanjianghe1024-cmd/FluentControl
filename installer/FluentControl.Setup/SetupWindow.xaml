<ui:FluentWindow x:Class="FluentControl.Setup.SetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="FluentControl Setup" Width="760" Height="650" MinWidth="560" MinHeight="420"
 WindowStartupLocation="CenterScreen" WindowCornerPreference="Round" WindowBackdropType="Mica"
 ExtendsContentIntoTitleBar="True" Background="{DynamicResource ApplicationBackgroundBrush}"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Segoe UI" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True" AutomationProperties.AutomationId="SetupWindow">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar x:Name="Caption" Title="FluentControl" ShowMaximize="False" Height="42" />
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,16,32,20">
    <Grid Margin="0,0,0,24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Width="64" Height="64" Source="Assets/FluentControl.png" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="1"><TextBlock Text="FluentControl" FontSize="30" FontWeight="SemiBold"/>
      <TextBlock x:Name="Tagline" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="VersionText" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.AutomationId="Heading"/>
    <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    <StackPanel x:Name="Options" Visibility="Collapsed">
     <Border CornerRadius="8" Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel><TextBlock x:Name="FolderLabel" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ui:TextBox x:Name="Folder" MinWidth="0" TextWrapping="NoWrap" AutomationProperties.AutomationId="InstallFolder"/>
        <ui:Button x:Name="Browse" Grid.Column="1" Margin="10,0,0,0" Click="Browse_Click" AutomationProperties.AutomationId="Browse"/>
       </Grid>
       <TextBlock x:Name="FolderHint" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="8" Padding="18" Margin="0,8,0,0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,16,0"><TextBlock x:Name="StartupLabel" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="StartupHint" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
       </StackPanel><ui:ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.AutomationId="StartWithWindows"/>
      </Grid>
     </Border>
    </StackPanel>
    <ProgressBar x:Name="Progress" Margin="0,12,0,12" Height="6" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.AutomationId="Progress"/>
    <TextBlock x:Name="ProgressText" Margin="0,0,0,12" TextWrapping="Wrap" AutomationProperties.AutomationId="ProgressText"/>
    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.AutomationId="ErrorText"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
   <StackPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel><ComboBox x:Name="LanguageChoice" MinWidth="125" Margin="0,0,8,6" SelectionChanged="Language_Changed" AutomationProperties.AutomationId="Language"/>
      <ComboBox x:Name="ThemeChoice" MinWidth="115" Margin="0,0,0,6" SelectionChanged="Theme_Changed" AutomationProperties.AutomationId="Theme"/>
     </WrapPanel><ui:Button x:Name="LogButton" Grid.Column="1" Appearance="Transparent" Click="Log_Click" VerticalAlignment="Top" AutomationProperties.AutomationId="OpenLog"/>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <ui:Button x:Name="RemoveButton" Margin="0,0,8,0" Click="Remove_Click" Visibility="Collapsed" AutomationProperties.AutomationId="Uninstall"/>
     <ui:Button x:Name="CloseButton" MinWidth="96" Margin="0,0,8,0" Click="Close_Click" AutomationProperties.AutomationId="Close"/>
     <ui:Button x:Name="PrimaryButton" MinWidth="120" Appearance="Primary" Click="Primary_Click" IsEnabled="False" AutomationProperties.AutomationId="Primary"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</ui:FluentWindow>
