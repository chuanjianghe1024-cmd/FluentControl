<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl" Culture="zh-CN" Codepage="936">
  <String Id="WelcomeDlgDescription">安装到当前用户，无需另外下载运行库。&#13;&#10;&#13;&#10;安装前请从托盘菜单退出旧版本。已有显示器配置会保留。</String>
  <String Id="VerifyReadyDlgInstallText">单击“安装”将 FluentControl 安装到：&#13;&#10;[INSTALLFOLDER]&#13;&#10;&#13;&#10;可在 Windows 设置中卸载，卸载时保留个人配置。</String>
</WixLocalization>
