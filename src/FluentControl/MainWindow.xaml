<Window x:Class="FluentControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Padding="32" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6"><TextBlock Text="控制中心" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="声音、麦克风与屏幕，在一个地方调节。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Center" Click="Refresh_Click" AutomationProperties.Name="刷新设备"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;"/><TextBlock Text="刷新设备"/></StackPanel></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20">
        <StackPanel Spacing="10"><TextBlock Text="音频" Style="{ThemeResource SubtitleTextBlockStyle}"/><StackPanel x:Name="AudioRows" Spacing="8"/></StackPanel>
        <StackPanel Spacing="10"><TextBlock Text="显示器" Style="{ThemeResource SubtitleTextBlockStyle}"/><StackPanel x:Name="MonitorRows" Spacing="8"/></StackPanel>
      </StackPanel>
    </ScrollViewer>
    <InfoBar x:Name="Status" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在读取设备…"/>
  </Grid>
</Window>
