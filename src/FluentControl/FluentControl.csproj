<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Keep the WinUI PRI publish targets enabled for unpackaged deployment. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FluentControl.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services/Locales.json" LogicalName="FluentControl.Locales.json" />

    <!-- The application uses WinUI/windowing, not the AI/ML/widgets metapackage.
         Keep the same WinUI component version as WindowsAppSDK 1.8.260921001. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" PrivateAssets="all" />
    <!-- CoreAudio endpoint control only; NAudio's umbrella also brings WinForms
         and the entire WindowsDesktop runtime into self-contained publishing. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <!-- ApplicationIcon is already indexed by the SDK. Copy the native tray icon
       after resource generation instead of adding a duplicate Content item. -->
  <Target Name="CopyTrayIconToOutput" AfterTargets="Build">
    <Copy SourceFiles="Assets/FluentControl.ico" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTrayIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="Assets/FluentControl.ico" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
