<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Keep the WinUI PRI publish targets enabled for unpackaged deployment. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Both executables share this runtime in build and publish output. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/FluentControl.ico</ApplicationIcon>
    <Product>FluentControl</Product>
    <Company>FluentControl</Company>
    <Description>FluentControl — display, audio and desktop controls. https://fctrl.app</Description>
    <PackageProjectUrl>https://fctrl.app</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <ProjectReference Include="../FluentControl.DdcHost/FluentControl.DdcHost.csproj" ReferenceOutputAssembly="false" AdditionalProperties="SelfContained=$(SelfContained)" />
    <ProjectReference Include="../FluentControl.FcsGateway/FluentControl.FcsGateway.csproj" ReferenceOutputAssembly="false" AdditionalProperties="SelfContained=$(SelfContained)" />
    <EmbeddedResource Include="Services/Locales.json" LogicalName="FluentControl.Locales.json" />
    <!-- Noncommercial license notice travels with every offline build/installer. -->
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- The application uses WinUI/windowing, not the AI/ML/widgets metapackage.
         Keep the same WinUI component version as WindowsAppSDK 1.8.260921001. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" PrivateAssets="all" />
    <!-- CoreAudio endpoint control only; NAudio's umbrella also brings WinForms
         and the entire WindowsDesktop runtime into self-contained publishing. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <Target Name="CopyDdcHostToOutput" AfterTargets="Build">
    <MSBuild Projects="../FluentControl.DdcHost/FluentControl.DdcHost.csproj" Targets="GetDdcHostPayload" Properties="Configuration=$(Configuration);Platform=$(Platform);SelfContained=$(SelfContained)">
      <Output TaskParameter="TargetOutputs" ItemName="DdcHostPayload" />
    </MSBuild>
    <Copy SourceFiles="@(DdcHostPayload)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDdcHostToPublish" AfterTargets="Publish">
    <ItemGroup><DdcHostPublished Include="$(OutDir)FluentControl.DdcHost.exe;$(OutDir)FluentControl.DdcHost.dll;$(OutDir)FluentControl.DdcHost.deps.json;$(OutDir)FluentControl.DdcHost.runtimeconfig.json" /></ItemGroup>
    <Copy SourceFiles="@(DdcHostPublished)" DestinationFolder="$(PublishDir)" />
  </Target>
  <Target Name="CopyFcsGatewayToOutput" AfterTargets="Build">
    <MSBuild Projects="../FluentControl.FcsGateway/FluentControl.FcsGateway.csproj" Targets="GetFcsGatewayPayload" Properties="Configuration=$(Configuration);Platform=$(Platform);SelfContained=$(SelfContained)">
      <Output TaskParameter="TargetOutputs" ItemName="FcsGatewayPayload" />
    </MSBuild>
    <Copy SourceFiles="@(FcsGatewayPayload)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyFcsGatewayToPublish" AfterTargets="Publish">
    <ItemGroup><FcsGatewayPublished Include="$(OutDir)FluentControl.FcsGateway.exe;$(OutDir)FluentControl.FcsGateway.dll;$(OutDir)FluentControl.FcsGateway.deps.json;$(OutDir)FluentControl.FcsGateway.runtimeconfig.json" /></ItemGroup>
    <Copy SourceFiles="@(FcsGatewayPublished)" DestinationFolder="$(PublishDir)" />
  </Target>
  <!-- ApplicationIcon is already indexed by the SDK. Copy the native tray icon
       after resource generation instead of adding a duplicate Content item. -->
  <Target Name="CopyTrayIconToOutput" AfterTargets="Build">
    <Copy SourceFiles="Assets/FluentControl.ico" DestinationFolder="$(OutDir)Assets" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTrayIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="Assets/FluentControl.ico" DestinationFolder="$(PublishDir)Assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
