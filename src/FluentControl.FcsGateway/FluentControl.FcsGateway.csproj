<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>FluentControl Sensors Gateway</Product>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../tools/gateway-scripts/runner.py" Link="fcs-script-runner.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <Target Name="GetFcsGatewayPayload" Returns="@(FcsGatewayPayload)">
    <ItemGroup>
      <FcsGatewayPayload Include="$(TargetDir)fcs-script-runner.py;$(TargetDir)FluentControl.FcsGateway.exe;$(TargetDir)FluentControl.FcsGateway.dll;$(TargetDir)FluentControl.FcsGateway.deps.json;$(TargetDir)FluentControl.FcsGateway.runtimeconfig.json" />
    </ItemGroup>
  </Target>
</Project>
